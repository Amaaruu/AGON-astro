---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada">
  <section class="section">
    <div class="container-agon max-w-xl text-center">
      <p class="text-6xl font-extrabold text-brand-700">404</p>
      <h1 class="mt-4 text-3xl">No encontramos esta página</h1>
      <p class="mt-3 text-slate-500">Puede que el enlace haya cambiado.</p>
      <a href="/" class="btn-primary mt-8">Ir al inicio</a>
    </div>
  </section>
</Layout>
