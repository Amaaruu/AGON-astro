---
import { previsiones } from '../data/isapres';
---

<div class="rounded-2xl bg-white p-6 shadow-2xl shadow-brand-950/10 ring-1 ring-slate-200 sm:p-8">
  <form id="contact-form" class="grid gap-4" novalidate>
    <input type="hidden" name="chequeo" value="" />
    <p data-chequeo-badge class="hidden rounded-xl bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
      ✓ Adjuntaremos el resultado de tu chequeo.
    </p>

    <div>
      <label for="nombre" class="field-label">Nombre</label>
      <input id="nombre" name="nombre" type="text" class="field-input" placeholder="Ej: Camila Rojas" autocomplete="name" required minlength="3" />
      <p class="field-error hidden" data-error-for="nombre">Ingresa tu nombre.</p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for="telefono" class="field-label">Teléfono</label>
        <input id="telefono" name="telefono" type="tel" class="field-input" placeholder="+56 9 1234 5678" autocomplete="tel" required />
        <p class="field-error hidden" data-error-for="telefono">Ingresa un celular válido (9 dígitos).</p>
      </div>
      <div>
        <label for="email" class="field-label">Email</label>
        <input id="email" name="email" type="email" class="field-input" placeholder="tucorreo@email.com" autocomplete="email" required />
        <p class="field-error hidden" data-error-for="email">Ingresa un email válido.</p>
      </div>
    </div>

    <div>
      <label for="prevision" class="field-label">Previsión actual</label>
      <select id="prevision" name="prevision" class="field-input" required>
        <option value="" disabled selected>Selecciona</option>
        {previsiones.map((p) => <option value={p.value}>{p.label}</option>)}
      </select>
      <p class="field-error hidden" data-error-for="prevision">Selecciona una opción.</p>
    </div>

    <label class="flex items-start gap-2 text-xs text-slate-500">
      <input type="checkbox" name="acepta" class="mt-0.5 h-4 w-4 rounded border-slate-300 accent-brand-700" required />
      <span>Acepto que AGON me contacte. Mis datos se usan solo para esta asesoría.</span>
    </label>
    <p class="field-error hidden -mt-3" data-error-for="acepta">Debes aceptar para continuar.</p>

    <button type="submit" class="btn-primary mt-1 w-full">
      <span data-label>Quiero que me contacten</span>
    </button>
  </form>
</div>

<script>
  import { initContactForm } from '../scripts/contact-form';
  initContactForm('contact-form');
</script>
