---
import { isapres } from '../data/isapres';
// TODO: reemplazar los nombres por logos (con autorización) en /public/isapres/
---

<section class="border-b border-slate-100 bg-white py-10">
  <div class="container-agon">
    <p class="text-center text-sm font-medium text-slate-500">Conocemos a fondo los planes de todas las isapres abiertas</p>
    <ul class="mt-6 flex flex-wrap items-center justify-center gap-3">
      {isapres.map((i) => (
        <li class="rounded-full border border-slate-200 bg-slate-50 px-5 py-2 text-sm font-semibold text-slate-600">
          {i.name}
        </li>
      ))}
    </ul>
  </div>
</section>
