---
import { whatsappUrl } from '../data/site';
interface Props {
  title?: string;
  text?: string;
}
const {
  title = '¿Quieres entender bien tus opciones?',
  text = 'Un asesor AGON revisa tu caso contigo, con información clara y sin presión.',
} = Astro.props;
---

<section class="section">
  <div class="container-agon">
    <div class="rounded-3xl bg-gradient-to-r from-brand-800 to-brand-600 px-6 py-14 text-center sm:px-12">
      <h2 class="text-3xl !text-white sm:text-4xl">{title}</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-brand-100">{text}</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/#contacto" class="btn-primary !bg-white !text-brand-800 hover:!bg-brand-50">Conversemos</a>
        <a href={whatsappUrl} target="_blank" rel="noopener" class="btn-secondary !border-white/30 !bg-transparent !text-white hover:!bg-white/10">Hablar por WhatsApp</a>
      </div>
    </div>
  </div>
</section>
