---
import SectionHeading from './ui/SectionHeading.astro';

const benefits = [
  { icon: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 0 1 14 0', title: 'Asesoría personalizada', text: 'Un asesor analiza tu caso y el de tu familia, no una tabla genérica.' },
  { icon: 'M4 19V9m6 10V5m6 14v-7m4 7H2', title: 'Comparación objetiva', text: 'Revisamos precio, coberturas, clínicas y topes de varias isapres.' },
  { icon: 'M12 3v18m5-14H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6', title: 'Sin costo para ti', text: 'Cotizar y asesorarte con AGON es gratis y sin compromiso.' },
  { icon: 'M9 12l2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z', title: 'Proceso claro', text: 'Te explicamos cada paso: declaración de salud, firma y vigencia.' },
  { icon: 'M3 12h4l3 8 4-16 3 8h4', title: 'Optimiza tu 7%', text: 'Buscamos el plan que mejor aprovecha tu cotización legal.' },
  { icon: 'M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9Zm-4.3 13a2 2 0 0 1-3.4 0', title: 'Acompañamiento continuo', text: 'Seguimos disponibles después de contratar, ante dudas o cambios.' },
];
---

<section class="section bg-slate-50">
  <div class="container-agon">
    <SectionHeading eyebrow="¿Por qué AGON?" title="Decidir tu plan de salud no debería ser complicado" />
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {benefits.map((b) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-6 transition hover:-translate-y-1 hover:shadow-lg hover:shadow-brand-900/5">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <path d={b.icon} />
            </svg>
          </div>
          <h3 class="mt-5 text-lg">{b.title}</h3>
          <p class="mt-2 text-slate-500">{b.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
