---
import ContactForm from './ContactForm.astro';
import { whatsappUrl } from '../data/site';
---

<section id="contacto" class="section scroll-mt-16 bg-gradient-to-b from-white to-brand-50/60">
  <div class="container-agon grid items-center gap-12 lg:grid-cols-2">
    <div>
      <p class="eyebrow">Conversemos</p>
      <h2 class="mt-2 text-3xl sm:text-4xl">Estamos aquí para ayudarte <span aria-hidden="true">🤝</span></h2>
      <p class="mt-4 max-w-md text-lg text-slate-500">
        Déjanos tus datos y un asesor te contactará. Sin costo ni compromiso.
      </p>
      <a href={whatsappUrl} target="_blank" rel="noopener" class="mt-6 inline-flex font-semibold text-brand-700 hover:text-brand-900">
        ¿Prefieres WhatsApp? Escríbenos →
      </a>
    </div>

    <ContactForm />
  </div>
</section>
