---
import SectionHeading from './ui/SectionHeading.astro';
import { derechos } from '../data/derechos';
---

<section id="derechos" class="section scroll-mt-16">
  <div class="container-agon">
    <SectionHeading
      eyebrow="Tus derechos"
      title="Lo que muchas personas no saben de su plan de salud"
      subtitle="Información que rara vez te explican al contratar y que puede cambiar cuánto pagas y cómo te atienden."
    />
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {derechos.map((d, i) => (
        <article class="relative flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-6 transition hover:-translate-y-1 hover:shadow-lg hover:shadow-brand-900/5">
          <span class="pointer-events-none absolute -top-3 -right-1 text-7xl font-extrabold text-brand-50 select-none" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="relative w-fit rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700">{d.tag}</span>
          <h3 class="relative mt-4 text-lg">{d.title}</h3>
          <p class="relative mt-2 text-slate-500">{d.text}</p>
        </article>
      ))}
    </div>
    <div class="mt-12 flex flex-col items-center gap-3 text-center">
      <p class="text-slate-600">¿Te pasó alguna de estas situaciones y no sabes qué hacer?</p>
      <a href="#contacto" class="btn-primary">Cuéntanos tu caso</a>
    </div>
  </div>
</section>
