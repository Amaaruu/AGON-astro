---
import SectionHeading from './ui/SectionHeading.astro';
import { derechos } from '../data/derechos';
---

<section id="derechos" class="section scroll-mt-16">
  <div class="container-agon">
    <SectionHeading eyebrow="Tus derechos" title="Lo que muchas personas no saben" />
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {derechos.map((d) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-6">
          <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700">{d.tag}</span>
          <h3 class="mt-4 text-lg">{d.title}</h3>
          <p class="mt-2 text-slate-500">{d.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
